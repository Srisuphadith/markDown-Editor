{
  "name": "markdown-editor",
  "productName": "Markdown Editor",
  "version": "1.0.0",
  "description": "Offline Markdown editor with live preview and tabs",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:win-installer": "electron-builder --win nsis",
    "build:docker": "./build-in-docker.sh"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.markdown-editor",
    "productName": "Markdown Editor",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      {
        "from": "..",
        "to": "app",
        "filter": [
          "markdownReader.html",
          "lib/**"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ],
    "afterPack": "build/adhoc-sign.js",
    "mac": {
      "identity": null,
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
